units metal
boundary p p p
atom_style bec
atom_modify map array
newton on
read_data ${data}
replicate ${replicate} ${replicate} ${replicate}

pair_style allegro
pair_coeff * * ${model} Li Nb O

velocity all set 0.0 0.0 0.0
fix integrator all nve
fix hold all setforce 0.0 0.0 0.0
neighbor 0.5 bin
neigh_modify every 1 delay 0 check yes
timestep 0.0001
thermo 0

run ${warmup}
variable block loop ${blocks}
label measured_blocks
run ${steps} pre no
next block
jump SELF measured_blocks

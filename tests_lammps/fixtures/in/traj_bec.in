units metal
boundary p p p
atom_style bec
atom_modify map array
newton on
read_data ${data}
read_bec ${bec}

pair_style allegro
pair_coeff * * ${model} Li Nb O
fix field all efield 0.0 0.0 0.0 coupling bec piezo no

# velocity create is processor-count dependent; frozen selects the
# deterministic zero-velocity start used by the serial-vs-MPI comparison.
# NVE still moves the lattice under the (nonzero) physical forces.
if "${frozen} == 1" then "velocity all set 0.0 0.0 0.0" else "velocity all create 300.0 19081 mom yes rot no dist gaussian"
fix integrator all nve
compute becprops all property/atom becxx becxy becxz becyx becyy becyz beczx beczy beczz
# NULL pair: exclude kinetic contributions from the moving lattice.
compute cstress all centroid/stress/atom NULL pair
compute press all pressure NULL pair
neighbor 0.5 bin
neigh_modify every 1 delay 0 check yes
timestep 0.0001
dump trajectory all custom 1 ${dump} id type x y z fx fy fz &
  c_becprops[1] c_becprops[2] c_becprops[3] c_becprops[4] c_becprops[5] &
  c_becprops[6] c_becprops[7] c_becprops[8] c_becprops[9] &
  c_cstress[1] c_cstress[2] c_cstress[3] c_cstress[4] c_cstress[5] &
  c_cstress[6] c_cstress[7] c_cstress[8] c_cstress[9]
dump_modify trajectory sort id format float %.16g
thermo 1
thermo_style custom step pe etotal temp fmax &
  c_press[1] c_press[2] c_press[3] c_press[4] c_press[5] c_press[6]
thermo_modify format float %.16g
run ${steps}

 /* ----------------------------------------------------------------------
+   The BEC dipole uses the same displacement as the position update.
    allow for both per-type and per-atom mass
 ------------------------------------------------------------------------- */
 
+template<class DeviceType>
+KOKKOS_INLINE_FUNCTION
+void FixNVEKokkos<DeviceType>::integrate_bec(int i, KK_FLOAT dt) const
+{
+  if (!bec.data()) return;
+  const double dx = dt * v(i,0);
+  const double dy = dt * v(i,1);
+  const double dz = dt * v(i,2);
+  for (int c = 0; c < 3; ++c)
+    dipole(i,c) += bec(i,3*c) * dx + bec(i,3*c+1) * dy + bec(i,3*c+2) * dz;
+}

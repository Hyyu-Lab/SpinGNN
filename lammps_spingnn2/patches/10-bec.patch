+template<class DeviceType>
+template<bool Constant>
+KOKKOS_INLINE_FUNCTION
+void FixEfieldKokkos<DeviceType>::bec_tally(int i, value_type result) const
+{
+  if (!(d_mask(i) & groupbit) || (region && !d_match[i])) return;
+
+  const double e[3] = {
+      !Constant && xstyle == ATOM ? qe2f * d_efield(i,0) : ex,
+      !Constant && ystyle == ATOM ? qe2f * d_efield(i,1) : ey,
+      !Constant && zstyle == ATOM ? qe2f * d_efield(i,2) : ez};
+  double f[3];
+  for (int c = 0; c < 3; ++c) {
+    f[c] = d_bec(i,c) * e[0] + d_bec(i,c+3) * e[1] + d_bec(i,c+6) * e[2];
+    d_f(i,c) += static_cast<KK_ACC_FLOAT>(f[c]);
+    result[1+c] += f[c];
+  }
+  if constexpr (Constant) {
+    result[0] -= d_bec_dipole(i,0) * ex + d_bec_dipole(i,1) * ey + d_bec_dipole(i,2) * ez;
+  } else if (estyle == ATOM && !qflag) {
+    result[0] += static_cast<double>(d_efield(i,3));
+  }
+  if (evflag) {
+    Few<double,3> x_i;
+    for (int c = 0; c < 3; ++c) x_i[c] = static_cast<double>(d_x(i,c));
+    const auto unwrap = DomainKokkos::unmap(prd, h, triclinic, x_i, d_image(i));
+    KK_FLOAT v[6] = {
+        static_cast<KK_FLOAT>(f[0] * unwrap[0]),
+        static_cast<KK_FLOAT>(f[1] * unwrap[1]),
+        static_cast<KK_FLOAT>(f[2] * unwrap[2]),
+        static_cast<KK_FLOAT>(f[0] * unwrap[1]),
+        static_cast<KK_FLOAT>(f[0] * unwrap[2]),
+        static_cast<KK_FLOAT>(f[1] * unwrap[2])};
+    v_tally(result, i, v);
+  }
+}
